{
  "name": "game-lobby",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "weekly": "node scripts/weekly.mjs",
    "smoke": "node --env-file=.env.local scripts/smokeMultiplayer.mjs",
    "smoke:spywords": "node --env-file=.env.local scripts/smokeSpyWords.mjs",
    "crossword:generate": "python3 scripts/crossword/repo_generate.py",
    "connections:audit": "node scripts/connectionsAudit.mjs",
    "connections:validate": "node scripts/validateConnections.mjs",
    "connections:regen": "node scripts/regenConnections.mjs",
    "connections:classic": "node scripts/genConnectionsClassic.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "an-array-of-english-words": "^2.0.0",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.64.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4",
    "ws": "^8.22.0"
  }
}
